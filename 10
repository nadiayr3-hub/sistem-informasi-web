#11: Form Interaktif dengan Input Types & Validasi HTML5
Membuat formulir yang kaya akan elemen input modern, validasi bawaan HTML5 (required, pattern, min/max), dan kontrol aksesibilitas.

HTML
<form action="/api/register" method="POST" enctype="multipart/form-data">
    <fieldset>
        <legend>Data Identitas User</legend>

        <!-- Input Teks, Email, dan Password -->
        <label for="username">Username:</label><br>
        <input type="text" id="username" name="username" required minlength="4" maxlength="20"><br><br>

        <label for="email">Email Kampus:</label><br>
        <input type="email" id="email" name="email" placeholder="user@student.ac.id" required><br><br>

        <!-- Selection Dropdown & Data List -->
        <label for="prodi">Program Studi:</label><br>
        <select id="prodi" name="prodi">
            <option value="">-- Pilih Program Studi --</option>
            <option value="SI">Sistem Informasi</option>
            <option value="IF">Informatika</option>
        </select><br><br>

        <!-- Input Angka, Datepicker, File Upload -->
        <label for="dob">Tanggal Lahir:</label><br>
        <input type="date" id="dob" name="dob"><br><br>

        <label for="avatar">Upload Pas Foto (PDF/PNG/JPG):</label><br>
        <input type="file" id="avatar" name="avatar" accept=".jpg,.png,.pdf"><br><br>

        <!-- Radio & Checkbox -->
        <label>Jenis Kelamin:</label><br>
        <input type="radio" id="pria" name="gender" value="L"> <label for="pria">Laki-laki</label>
        <input type="radio" id="wanita" name="gender" value="P"> <label for="wanita">Perempuan</label><br><br>

        <input type="checkbox" id="terms" name="terms" required>
        <label for="terms">Saya menyetujui syarat & ketentuan yang berlaku.</label><br><br>

        <button type="submit">Daftar Akun</button>
        <button type="reset">Reset Input</button>
    </fieldset>
</form>
